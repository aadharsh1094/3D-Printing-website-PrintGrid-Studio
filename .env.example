# Admin login (change these before going to production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=printgrid-admin

# Secret for signing admin session cookies. Must be at least 32 chars.
# Generate a random one: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# WhatsApp number where customer orders get forwarded.
# Format: country code + number, no spaces or symbols. Example for India: 919876543210
WHATSAPP_PHONE=919999999999
